<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <VideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/player_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="22dp">

        <TextView
            android:id="@+id/playerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="小猪佩奇" />

        <TextView
            android:id="@+id/playerProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_yellow"
            android:textSize="24sp"
            tools:text="第 1/4 集" />
    </LinearLayout>

    <TextView
        android:id="@+id/announcement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/soft_panel"
        android:paddingStart="34dp"
        android:paddingTop="20dp"
        android:paddingEnd="34dp"
        android:paddingBottom="20dp"
        android:textColor="@color/text_primary"
        android:textSize="30sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="这是第 1 集，还有 4 集" />

    <LinearLayout
        android:id="@+id/restPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/rest_look_outside"
            android:textColor="@color/accent_yellow"
            android:textSize="48sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/restTrafficLight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/traffic_light_housing"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/traffic_light_red">

                <TextView
                    android:id="@+id/restRedLightText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="#570A12"
                    android:textSize="36sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/traffic_light_yellow">

                <TextView
                    android:id="@+id/restYellowLightText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="#594000"
                    android:textSize="36sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:background="@drawable/traffic_light_green">

                <TextView
                    android:id="@+id/restGreenLightText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="#00492F"
                    android:textSize="36sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/restPhaseText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:textColor="@color/accent_yellow"
            android:textSize="31sp"
            android:textStyle="bold"
            tools:text="红灯 · 眼睛休息" />

        <TextView
            android:id="@+id/restCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="26sp"
            tools:text="还有 20 秒" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/rest_hint"
            android:textColor="@color/text_secondary"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/donePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#DD121B47"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/session_done_title"
            android:textColor="@color/accent_yellow"
            android:textSize="52sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/doneMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_primary"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/parent_exit"
            android:textColor="@color/text_secondary"
            android:textSize="20sp" />
    </LinearLayout>
</FrameLayout>
