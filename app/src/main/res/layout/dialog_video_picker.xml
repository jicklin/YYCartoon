<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/library_dialog_background"
    android:orientation="vertical"
    android:paddingStart="30dp"
    android:paddingTop="26dp"
    android:paddingEnd="30dp"
    android:paddingBottom="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/video_picker_title"
                android:textColor="@color/text_primary"
                android:textSize="31sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/video_picker_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/videoPickerCloseButton"
            android:layout_width="92dp"
            android:layout_height="46dp"
            android:layout_marginStart="22dp"
            android:background="@drawable/parent_cancel_button"
            android:stateListAnimator="@null"
            android:text="@string/close"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fadeScrollbars="false"
        android:paddingBottom="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/showRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/season_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fadeScrollbars="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/seasonRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/episode_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:paddingBottom="4dp"
        android:scrollbars="vertical">

        <GridLayout
            android:id="@+id/videoGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3" />
    </ScrollView>
</LinearLayout>
