<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/episodeCard"
    android:layout_width="228dp"
    android:layout_height="88dp"
    android:background="@drawable/library_card_focus"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/episodeNameText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="42dp"
        android:paddingBottom="26dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/episodeStateText"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|end"
        android:layout_margin="9dp"
        android:background="@drawable/library_state_badge"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/episodePlayCountText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="9dp"
        android:background="@drawable/library_badge"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        android:visibility="gone" />
</FrameLayout>
