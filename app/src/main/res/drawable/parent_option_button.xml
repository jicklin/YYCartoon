<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#3C346E" />
            <stroke android:width="4dp" android:color="@color/accent_yellow" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#3E387D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#302B5A" />
            <stroke android:width="2dp" android:color="#8179B7" />
        </shape>
    </item>
</selector>
