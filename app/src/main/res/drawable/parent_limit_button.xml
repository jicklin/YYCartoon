<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#33234F" />
            <stroke android:width="4dp" android:color="@color/accent_yellow" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#51345F" />
            <stroke android:width="3dp" android:color="@color/accent_yellow" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#30305E" />
            <stroke android:width="4dp" android:color="@color/text_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#373A72" />
            <stroke android:width="2dp" android:color="#6F72A5" />
        </shape>
    </item>
</selector>
