<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#30305E" />
            <stroke android:width="4dp" android:color="@color/accent_yellow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#2C3268" />
            <stroke android:width="2dp" android:color="#676D9E" />
        </shape>
    </item>
</selector>
